#!/usr/bin/env sh
# Self-bootstrap launcher for the official Gradle 8.9 Wrapper JAR.
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_DIR="$APP_HOME/gradle/wrapper"
WRAPPER_JAR="$WRAPPER_DIR/gradle-wrapper.jar"
WRAPPER_URL="https://raw.githubusercontent.com/gradle/gradle/v8.9.0/gradle/wrapper/gradle-wrapper.jar"
EXPECTED_SHA256="498495120a03b9a6ab5d155f5de3c8f0d986a449153702fb80fc80e134484f17"
mkdir -p "$WRAPPER_DIR"
if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Downloading Gradle Wrapper 8.9..."
  if command -v curl >/dev/null 2>&1; then curl -fsSL "$WRAPPER_URL" -o "$WRAPPER_JAR"
  elif command -v wget >/dev/null 2>&1; then wget -q "$WRAPPER_URL" -O "$WRAPPER_JAR"
  else echo "curl or wget is required to bootstrap Gradle Wrapper." >&2; exit 1; fi
fi
if command -v sha256sum >/dev/null 2>&1; then ACTUAL_SHA256=$(sha256sum "$WRAPPER_JAR" | awk '{print $1}')
elif command -v shasum >/dev/null 2>&1; then ACTUAL_SHA256=$(shasum -a 256 "$WRAPPER_JAR" | awk '{print $1}')
else echo "sha256sum or shasum is required to verify Gradle Wrapper." >&2; exit 1; fi
if [ "$ACTUAL_SHA256" != "$EXPECTED_SHA256" ]; then
  rm -f "$WRAPPER_JAR"
  echo "Invalid Gradle Wrapper checksum; downloaded file removed." >&2
  exit 1
fi
exec java -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
